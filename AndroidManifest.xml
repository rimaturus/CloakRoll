<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.rimaturus.photovault" android:versionCode="12" android:versionName="1.9.2">
    <!-- Application id io.github.rimaturus.photovault (as on Google Play); the Java code lives in package app.photovault -->
    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="36" />

    <!-- The complete list of permissions. No contacts, location, camera or microphone access. Photos are read only
         if you turn on automatic backup (the permission is asked for then); otherwise only what you pick. -->
    <uses-permission android:name="android.permission.INTERNET" />                     <!-- talk to Amazon Photos, OneDrive or Google Drive -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />                <!-- optional fingerprint unlock -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />           <!-- uploads continue in background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />           <!-- upload progress notification -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />            <!-- automatic backup only, optional -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" /> <!-- Android 14+: "only the selected photos" -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />       <!-- the automatic backup job survives a restart -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />         <!-- the job scheduler needs it to wait for Wi-Fi -->

    <application android:label="Cloakroll" android:icon="@mipmap/ic_launcher"
        android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false" android:largeHeap="true"
        android:enableOnBackInvokedCallback="true" android:localeConfig="@xml/locales_config"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">
        <activity android:name="app.photovault.MainActivity" android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- OneDrive and Google Drive sign-in: the browser comes back here (OAuth redirect, checked with PKCE and state) -->
        <activity android:name="app.photovault.AuthRedirect" android:exported="true" android:noHistory="true"
            android:excludeFromRecents="true" android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="io.github.rimaturus.photovault" />
            </intent-filter>
        </activity>
        <service android:name="app.photovault.SyncService" android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- automatic backup: run by Android's job scheduler about hourly on Wi-Fi -->
        <service android:name="app.photovault.Backup" android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
